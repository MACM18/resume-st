# Local Node connection. URL-encode special characters in the password.
DATABASE_URL=postgresql://devadmin:CHANGE_ME@127.0.0.1:5432/sehani?schema=portfolio
# Docker uses the existing database container over its external network.
DOCKER_DATABASE_URL=postgresql://devadmin:CHANGE_ME@dev-postgres:5432/sehani?schema=portfolio
POSTGRES_NETWORK=dev-network
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
APP_PORT=3000
# Explicit development preview only. Never enable on the production site.
DEMO_MODE=false
# Set true only behind a trusted proxy that overwrites X-Real-IP.
TRUST_PROXY=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=portfolio
S3_ACCESS_KEY=local-portfolio
S3_SECRET_KEY=REPLACE_WITH_RANDOM_LOCAL_SECRET
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Portfolio <portfolio@localhost>
CONTACT_TO=owner@localhost

# One-time provisioning; existing account passwords are never overwritten.
ADMIN_1_EMAIL=
ADMIN_1_NAME=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_NAME=
ADMIN_2_PASSWORD=
