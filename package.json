{
  "name": "sunny-portfolio",
  "version": "1.0.0",
  "description": "A yellow scrapbook portfolio and private publishing studio",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "admin:bootstrap": "tsx scripts/bootstrap.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run admin:bootstrap",
    "storage:init": "tsx scripts/init-storage.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MACM18/resume-st.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/MACM18/resume-st/issues"
  },
  "homepage": "https://github.com/MACM18/resume-st#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1"
  },
  "engines": {
    "node": ">=24"
  }
}
